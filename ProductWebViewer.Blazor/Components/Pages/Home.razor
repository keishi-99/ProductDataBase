    // 列見出しクリックでの並び替え共通ロジック（同じ列を再クリックでasc/desc反転、別列なら常にasc）
    private static string NextSortDir(string sortCol, string sortDir, string col) =>
        sortCol == col && sortDir == "asc" ? "desc" : "asc";

    private static string SortIcon(string sortCol, string sortDir, string col) =>
        sortCol == col ? (sortDir == "asc" ? "▲" : "▼") : "⇅";

    protected override void OnInitialized() {
        _categoryList = ProductRepo.GetCategoryList();
        _productNameList = ProductRepo.GetProductNameList(null);
        _productTypeList = ProductRepo.GetProductTypeList(null, null);

        _subCategoryList = SubstrateRepo.GetCategoryList();
        _subProductNameList = SubstrateRepo.GetProductNameList(null);
        _substrateNameList = SubstrateRepo.GetSubstrateNameList(null, null);
    }

    // ----- 製品タブ: カスケードリストボックス -----
    // 本家 ProductWebViewer と同様、リストボックスはどれを変更しても即座に検索結果へ反映される
    private Task OnCategoryChangedAsync(ChangeEventArgs e) {
        _listCategory = e.Value?.ToString() ?? "";

        _productNameList = ProductRepo.GetProductNameList(_listCategory);
        if (!_productNameList.Contains(_listProductName))
            _listProductName = "";

        _productTypeList = ProductRepo.GetProductTypeList(_listCategory, _listProductName);
        if (!_productTypeList.Contains(_listProductType))
            _listProductType = "";

        return SearchAsync();
    }

    private Task OnProductNameChangedAsync(ChangeEventArgs e) {
        _listProductName = e.Value?.ToString() ?? "";

        _productTypeList = ProductRepo.GetProductTypeList(_listCategory, _listProductName);
        if (!_productTypeList.Contains(_listProductType))
            _listProductType = "";

        return SearchAsync();
    }

    private Task OnProductTypeChangedAsync(ChangeEventArgs e) {
        _listProductType = e.Value?.ToString() ?? "";
        return SearchAsync();
    }

    private Task SwitchProductTabAsync(string tab) {
        _productActiveTab = tab;
        _pageNum = 1;
        return _hasSearched ? RunSearchAsync() : Task.CompletedTask;
    }

    private Task SortProductAsync(string col) {
        _productSortDir = NextSortDir(_productSortCol, _productSortDir, col);
        _productSortCol = col;
        _pageNum = 1;
        return RunSearchAsync();
    }

    private Task SortSerialAsync(string col) {
        _serialSortDir = NextSortDir(_serialSortCol, _serialSortDir, col);
        _serialSortCol = col;
        _pageNum = 1;
        return RunSearchAsync();
    }

    private Task SearchAsync() {
        _pageNum = 1;
        _hasSearched = true;
        return RunSearchAsync();
    }

    private Task GoToPageAsync(int page) {
        if (page < 1 || page > TotalPages) return Task.CompletedTask;
        _pageNum = page;
        return RunSearchAsync();
    }

    private Task RunSearchAsync() {
        try {
            if (_productActiveTab == "serial") {
                _totalCount = ProductRepo.GetSerialCount(
                    _listCategory, _listProductName, _listProductType,
                    _filterProductName, _filterOrderNumber, _filterProductNumber,
                    _filterProductDateType, _filterProductDateFrom, _filterProductDateTo, _filterSerial);
                _serialRecords = ProductRepo.GetSerialHistory(
                    _listCategory, _listProductName, _listProductType,
                    _filterProductName, _filterOrderNumber, _filterProductNumber,
                    _filterProductDateType, _filterProductDateFrom, _filterProductDateTo, _filterSerial,
                    _serialSortCol, _serialSortDir, page: _pageNum, pageSize: _pageSize);
            } else {
                _totalCount = ProductRepo.GetCount(
                    _listCategory, _listProductName, _listProductType,
                    _filterProductName, _filterOrderNumber, _filterProductNumber,
                    _filterProductDateType, _filterProductDateFrom, _filterProductDateTo);
                _records = ProductRepo.GetAll(
                    _listCategory, _listProductName, _listProductType,
                    _filterProductName, _filterOrderNumber, _filterProductNumber,
                    _filterProductDateType, _filterProductDateFrom, _filterProductDateTo,
                    _productSortCol, _productSortDir, page: _pageNum, pageSize: _pageSize);
            }
            _errorMessage = null;
        } catch (Exception) {
            _records = [];
            _serialRecords = [];
            _totalCount = 0;
            _errorMessage = "データの取得中にエラーが発生しました。";
        }
        return Task.CompletedTask;
    }

