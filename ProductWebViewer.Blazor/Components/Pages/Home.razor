@page "/"
@rendermode InteractiveServer
@using ProductWebViewer.Blazor.Data
@using ProductWebViewer.Blazor.Models
@inject ProductRecordRepository ProductRepo
@inject SubstrateRecordRepository SubstrateRepo

<PageTitle>製品・基板データ閲覧</PageTitle>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <button type="button" class="nav-link @(_activeTab == "product" ? "active" : "")" @onclick='() => _activeTab = "product"'>製品登録実績</button>
    </li>
    <li class="nav-item">
        <button type="button" class="nav-link @(_activeTab == "substrate" ? "active" : "")" @onclick='() => _activeTab = "substrate"'>基板登録実績</button>
    </li>
</ul>

@if (_activeTab == "product") {
    <div class="row g-2 mb-2">
        <div class="col-auto" style="width: 100px;">
            <div class="fw-bold small mb-1">カテゴリ</div>
            <div class="list-box">
                <select size="10" value="@_listCategory" @onchange="OnCategoryChangedAsync">
                    <option value="">（すべて）</option>
                    @foreach (var c in _categoryList) {
                        <option value="@c">@c</option>
                    }
                </select>
            </div>
        </div>
        <div class="col-auto" style="width: 250px;">
            <div class="fw-bold small mb-1">製品名</div>
            <div class="list-box">
                <select size="10" value="@_listProductName" @onchange="OnProductNameChangedAsync">
                    <option value="">（すべて）</option>
                    @foreach (var p in _productNameList) {
                        <option value="@p">@p</option>
                    }
                </select>
            </div>
        </div>
        <div class="col-auto" style="width: 350px;">
            <div class="fw-bold small mb-1">種別</div>
            <div class="list-box">
                <select size="10" value="@_listProductType" @onchange="OnProductTypeChangedAsync">
                    <option value="">（すべて）</option>
                    @foreach (var t in _productTypeList) {
                        <option value="@t">@t</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <div class="d-flex align-items-center gap-3 mb-2">
        <div class="btn-group btn-group-sm">
            <button type="button" class="btn @(_productActiveTab != "serial" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => SwitchProductTabAsync("records")'>登録実績</button>
            <button type="button" class="btn @(_productActiveTab == "serial" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => SwitchProductTabAsync("serial")'>シリアル履歴</button>
        </div>
    </div>

    <div class="row g-2 mb-2 align-items-center">
        <div class="col-auto">
            <input type="search" class="form-control form-control-sm" style="width: 150px"
                   @bind="_filterProductName" @bind:event="oninput" placeholder="製品名（テキスト）" />
        </div>
        <div class="col-auto">
            <input type="search" class="form-control form-control-sm" style="width: 150px"
                   @bind="_filterOrderNumber" @bind:event="oninput" placeholder="注文番号" />
        </div>
        <div class="col-auto">
            <input type="search" class="form-control form-control-sm" style="width: 150px"
                   @bind="_filterProductNumber" @bind:event="oninput" placeholder="製造番号" />
        </div>
        <div class="col-auto d-flex align-items-center gap-1">
            <select class="form-select form-select-sm" style="width: auto" @bind="_filterProductDateType">
                <option value="regDate">登録日</option>
                <option value="createdAt">登録日時</option>
            </select>
            <input type="date" class="form-control form-control-sm" value="@_filterProductDateFrom"
                   @onchange='e => _filterProductDateFrom = e.Value?.ToString() ?? ""' />
            <span class="text-muted small">〜</span>
            <input type="date" class="form-control form-control-sm" value="@_filterProductDateTo"
                   @onchange='e => _filterProductDateTo = e.Value?.ToString() ?? ""' />
        </div>
        @if (_productActiveTab == "serial") {
            <div class="col-auto">
                <input type="search" class="form-control form-control-sm" style="width: 150px"
                       @bind="_filterSerial" @bind:event="oninput" placeholder="シリアル番号" />
            </div>
        }
        <div class="col-auto">
            <button class="btn btn-sm btn-primary" @onclick="SearchAsync">検索</button>
        </div>
        @if (_hasSearched) {
            <div class="col-auto">
                <a class="btn btn-sm btn-outline-success" href="@ProductCsvUrl">CSVエクスポート</a>
            </div>
        }
    </div>

    @if (_errorMessage is not null) {
        <div class="alert alert-danger">@_errorMessage</div>
    }

    @if (_hasSearched) {
        <div class="results-area">
        <div class="d-flex justify-content-between align-items-center">
            <p class="text-muted mb-1">@_totalCount 件中 @(ProductRecordCount == 0 ? 0 : (_pageNum - 1) * _pageSize + 1)〜@((_pageNum - 1) * _pageSize + ProductRecordCount) 件を表示</p>
            <ColumnToggle Columns="@(_productActiveTab == "serial" ? _serialCols : _productCols)"
                          Hidden="@(_productActiveTab == "serial" ? _serialHiddenCols : _productHiddenCols)"
                          OnChanged="StateHasChanged" />
        </div>

        <div class="table-responsive">
            @if (_productActiveTab != "serial") {
                <table class="table table-striped table-hover align-middle table-sm">
                    <thead>
                        <tr>
                            <th></th>
                            <th></th>
                            @foreach (var (label, key) in _productCols) {
                                if (!_productHiddenCols.Contains(label)) {
                                    <th class="sortable" @onclick="() => SortProductAsync(key)">@label <span class="small text-muted">@SortIcon(_productSortCol, _productSortDir, key)</span></th>
                                }
                            }
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _records) {
                            <tr>
                                <td>
                                    <AuthorizeView>
                                        <a class="btn btn-sm btn-outline-warning" href="@($"/products/{r.Id}/edit")">編集</a>
                                    </AuthorizeView>
                                </td>
                                <td><button type="button" class="btn btn-sm btn-outline-info" @onclick="() => ShowProductDetail(r)">詳細</button></td>
                                @if (!_productHiddenCols.Contains("ID")) { <td>@r.Id</td> }
                                @if (!_productHiddenCols.Contains("カテゴリ")) { <td>@r.CategoryName</td> }
                                @if (!_productHiddenCols.Contains("製品名")) { <td>@r.ProductName</td> }
                                @if (!_productHiddenCols.Contains("種別")) { <td>@r.ProductType</td> }
                                @if (!_productHiddenCols.Contains("型式")) { <td>@r.ProductModel</td> }
                                @if (!_productHiddenCols.Contains("注文番号")) { <td>@r.OrderNumber</td> }
                                @if (!_productHiddenCols.Contains("製造番号")) { <td>@r.ProductNumber</td> }
                                @if (!_productHiddenCols.Contains("O-Les番号")) { <td>@r.OLesNumber</td> }
                                @if (!_productHiddenCols.Contains("数量")) { <td>@r.Quantity</td> }
                                @if (!_productHiddenCols.Contains("担当者")) { <td>@r.PersonInfo</td> }
                                @if (!_productHiddenCols.Contains("登録日")) { <td>@r.RegDate</td> }
                                @if (!_productHiddenCols.Contains("Revision")) { <td>@r.Revision</td> }
                                @if (!_productHiddenCols.Contains("シリアル開始")) { <td>@r.SerialFirst</td> }
                                @if (!_productHiddenCols.Contains("シリアル終了")) { <td>@r.SerialLast</td> }
                                @if (!_productHiddenCols.Contains("コメント")) { <td>@r.Comment</td> }
                                @if (!_productHiddenCols.Contains("登録日時")) { <td>@r.CreatedAt</td> }
                                <td><button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => ShowUsedSubstrates(r.Id)">使用基板</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            } else {
                <table class="table table-striped table-hover align-middle table-sm">
                    <thead>
                        <tr>
                            @foreach (var (label, key) in _serialCols) {
                                if (!_serialHiddenCols.Contains(label)) {
                                    <th class="sortable" @onclick="() => SortSerialAsync(key)">@label <span class="small text-muted">@SortIcon(_serialSortCol, _serialSortDir, key)</span></th>
                                }
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _serialRecords) {
                            <tr>
                                @if (!_serialHiddenCols.Contains("No.")) { <td>@r.RowId</td> }
                                @if (!_serialHiddenCols.Contains("シリアル番号")) { <td>@r.Serial</td> }
                                @if (!_serialHiddenCols.Contains("O-Lesシリアル")) { <td>@r.OLesSerial</td> }
                                @if (!_serialHiddenCols.Contains("注文番号")) { <td>@r.OrderNumber</td> }
                                @if (!_serialHiddenCols.Contains("製番")) { <td>@r.ProductNumber</td> }
                                @if (!_serialHiddenCols.Contains("製品名")) { <td>@r.ProductName</td> }
                                @if (!_serialHiddenCols.Contains("種別")) { <td>@r.ProductType</td> }
                                @if (!_serialHiddenCols.Contains("型式")) { <td>@r.ProductModel</td> }
                                @if (!_serialHiddenCols.Contains("登録日")) { <td>@r.RegDate</td> }
                                @if (!_serialHiddenCols.Contains("登録日時")) { <td>@r.CreatedAt</td> }
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <nav>
            <ul class="pagination">
                <li class="page-item @(_pageNum <= 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => GoToPageAsync(_pageNum - 1)">前へ</button>
                </li>
                <li class="page-item disabled"><span class="page-link">@_pageNum / @TotalPages</span></li>
                <li class="page-item @(_pageNum >= TotalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => GoToPageAsync(_pageNum + 1)">次へ</button>
                </li>
            </ul>
        </nav>
        </div>
    }
}
else {
    <div class="row g-2 mb-2">
        <div class="col-auto" style="width: 100px;">
            <div class="fw-bold small mb-1">カテゴリ</div>
            <div class="list-box">
                <select size="10" value="@_listSubCategory" @onchange="OnSubCategoryChangedAsync">
                    <option value="">（すべて）</option>
                    @foreach (var c in _subCategoryList) {
                        <option value="@c">@c</option>
                    }
                </select>
            </div>
        </div>
        <div class="col-auto" style="width: 250px;">
            <div class="fw-bold small mb-1">製品名</div>
            <div class="list-box">
                <select size="10" value="@_listSubProductName" @onchange="OnSubProductNameChangedAsync">
                    <option value="">（すべて）</option>
                    @foreach (var p in _subProductNameList) {
                        <option value="@p">@p</option>
                    }
                </select>
            </div>
        </div>
        <div class="col-auto" style="width: 350px;">
            <div class="fw-bold small mb-1">基板名</div>
            <div class="list-box">
                <select size="10" value="@_listSubstrateName" @onchange="OnSubstrateNameChangedAsync">
                    <option value="">（すべて）</option>
                    @foreach (var s in _substrateNameList) {
                        <option value="@s">@s</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <div class="d-flex align-items-center gap-3 mb-2">
        <div class="btn-group btn-group-sm">
            <button type="button" class="btn @(_subActiveTab != "stock" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => SwitchSubTabAsync("records")'>登録実績</button>
            <button type="button" class="btn @(_subActiveTab == "stock" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => SwitchSubTabAsync("stock")'>在庫数</button>
        </div>
        @if (_subActiveTab == "stock") {
            <div class="btn-group btn-group-sm">
                <button type="button" class="btn @(_stockGroupByModel ? "btn-info" : "btn-outline-info")" @onclick="() => SwitchStockGroupAsync(true)">基板単位</button>
                <button type="button" class="btn @(!_stockGroupByModel ? "btn-info" : "btn-outline-info")" @onclick="() => SwitchStockGroupAsync(false)">製造番号単位</button>
            </div>
            <div class="form-check form-check-inline mb-0">
                <input class="form-check-input" type="checkbox" id="excludeZeroStock" @bind="_excludeZeroStock" @bind:after="SubSearchAsync" />
                <label class="form-check-label small" for="excludeZeroStock">在庫0を除外</label>
            </div>
        }
    </div>

    <div class="row g-2 mb-2 align-items-center">
        <div class="col-auto">
            <input type="search" class="form-control form-control-sm" style="width: 150px"
                   @bind="_filterSubstrateName" @bind:event="oninput" placeholder="基板名（テキスト）" />
        </div>
        @if (_subActiveTab != "stock" || !_stockGroupByModel) {
            <div class="col-auto">
                <input type="search" class="form-control form-control-sm" style="width: 150px"
                       @bind="_filterSubOrderNumber" @bind:event="oninput" placeholder="注文番号" />
            </div>
            <div class="col-auto">
                <input type="search" class="form-control form-control-sm" style="width: 150px"
                       @bind="_filterSubstrateNumber" @bind:event="oninput" placeholder="製造番号" />
            </div>
        }
        @if (_subActiveTab != "stock") {
            <div class="col-auto d-flex align-items-center gap-1">
                <select class="form-select form-select-sm" style="width: auto" @bind="_filterSubDateType">
                    <option value="regDate">登録日</option>
                    <option value="createdAt">登録日時</option>
                </select>
                <input type="date" class="form-control form-control-sm" value="@_filterSubDateFrom"
                       @onchange='e => _filterSubDateFrom = e.Value?.ToString() ?? ""' />
                <span class="text-muted small">〜</span>
                <input type="date" class="form-control form-control-sm" value="@_filterSubDateTo"
                       @onchange='e => _filterSubDateTo = e.Value?.ToString() ?? ""' />
            </div>
        }
        <div class="col-auto">
            <button class="btn btn-sm btn-primary" @onclick="SubSearchAsync">検索</button>
        </div>
        @if (_subHasSearched && _subActiveTab != "stock") {
            <div class="col-auto">
                <a class="btn btn-sm btn-outline-success" href="@SubstrateCsvUrl">CSVエクスポート</a>
            </div>
        }
    </div>

    @if (_subErrorMessage is not null) {
        <div class="alert alert-danger">@_subErrorMessage</div>
    }

    @if (_subHasSearched) {
        <div class="results-area">
        <div class="d-flex justify-content-between align-items-center">
            <p class="text-muted mb-1">@_subTotalCount 件中 @(SubRecordCount == 0 ? 0 : (_subPageNum - 1) * _subPageSize + 1)〜@((_subPageNum - 1) * _subPageSize + SubRecordCount) 件を表示</p>
            <ColumnToggle Columns="@(_subActiveTab == "stock" ? CurrentStockCols : _substrateCols)"
                          Hidden="@(_subActiveTab == "stock" ? _stockHiddenCols : _substrateHiddenCols)"
                          OnChanged="StateHasChanged" />
        </div>

        <div class="table-responsive">
            @if (_subActiveTab != "stock") {
                <table class="table table-striped table-hover align-middle table-sm">
                    <thead>
                        <tr>
                            <th></th><th></th>
                            @foreach (var (label, key) in _substrateCols) {
                                if (!_substrateHiddenCols.Contains(label)) {
                                    <th class="sortable" @onclick="() => SortSubstrateAsync(key)">@label <span class="small text-muted">@SortIcon(_subSortCol, _subSortDir, key)</span></th>
                                }
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _substrateRecords) {
                            <tr>
                                <td>
                                    <AuthorizeView>
                                        <a class="btn btn-sm btn-outline-danger" href="@($"/substrates/{r.Id}/delete")">削除</a>
                                    </AuthorizeView>
                                </td>
                                <td><button type="button" class="btn btn-sm btn-outline-info" @onclick="() => ShowSubstrateDetail(r)">詳細</button></td>
                                @if (!_substrateHiddenCols.Contains("ID")) { <td>@r.Id</td> }
                                @if (!_substrateHiddenCols.Contains("カテゴリ")) { <td>@r.CategoryName</td> }
                                @if (!_substrateHiddenCols.Contains("製品名")) { <td>@r.ProductName</td> }
                                @if (!_substrateHiddenCols.Contains("基板名")) { <td>@r.SubstrateName</td> }
                                @if (!_substrateHiddenCols.Contains("基板型式")) { <td>@r.SubstrateModel</td> }
                                @if (!_substrateHiddenCols.Contains("注文番号")) { <td>@r.OrderNumber</td> }
                                @if (!_substrateHiddenCols.Contains("製造番号")) { <td>@r.SubstrateNumber</td> }
                                @if (!_substrateHiddenCols.Contains("入庫")) { <td>@r.Increase</td> }
                                @if (!_substrateHiddenCols.Contains("出庫")) { <td>@r.Decrease</td> }
                                @if (!_substrateHiddenCols.Contains("不良")) { <td>@r.Defect</td> }
                                @if (!_substrateHiddenCols.Contains("使用製品名")) { <td>@r.UseProductName</td> }
                                @if (!_substrateHiddenCols.Contains("使用注文番号")) { <td>@r.UseOrderNumber</td> }
                                @if (!_substrateHiddenCols.Contains("使用製造番号")) { <td>@r.UseProductNumber</td> }
                                @if (!_substrateHiddenCols.Contains("担当者")) { <td>@r.PersonInfo</td> }
                                @if (!_substrateHiddenCols.Contains("登録日")) { <td>@r.RegDate</td> }
                                @if (!_substrateHiddenCols.Contains("コメント")) { <td>@r.Comment</td> }
                                @if (!_substrateHiddenCols.Contains("登録日時")) { <td>@r.CreatedAt</td> }
                            </tr>
                        }
                    </tbody>
                </table>
            } else {
                <table class="table table-striped table-hover align-middle table-sm">
                    <thead>
                        <tr>
                            @foreach (var (label, key) in CurrentStockCols) {
                                if (!_stockHiddenCols.Contains(label)) {
                                    <th class="sortable" @onclick="() => SortStockAsync(key)">@label <span class="small text-muted">@SortIcon(_stockSortCol, _stockSortDir, key)</span></th>
                                }
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _stockRecords) {
                            <tr>
                                @if (!_stockHiddenCols.Contains("カテゴリ")) { <td>@r.CategoryName</td> }
                                @if (!_stockHiddenCols.Contains("製品名")) { <td>@r.ProductName</td> }
                                @if (!_stockHiddenCols.Contains("基板名")) { <td>@r.SubstrateName</td> }
                                @if (!_stockHiddenCols.Contains("基板型式")) { <td>@r.SubstrateModel</td> }
                                @if (!_stockGroupByModel) {
                                    @if (!_stockHiddenCols.Contains("製造番号")) { <td>@r.SubstrateNumber</td> }
                                    @if (!_stockHiddenCols.Contains("注文番号")) { <td>@r.OrderNumber</td> }
                                }
                                @if (!_stockHiddenCols.Contains("在庫数")) { <td>@r.Stock</td> }
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <nav>
            <ul class="pagination">
                <li class="page-item @(_subPageNum <= 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => SubGoToPageAsync(_subPageNum - 1)">前へ</button>
                </li>
                <li class="page-item disabled"><span class="page-link">@_subPageNum / @SubTotalPages</span></li>
                <li class="page-item @(_subPageNum >= SubTotalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => SubGoToPageAsync(_subPageNum + 1)">次へ</button>
                </li>
            </ul>
        </nav>
        </div>
    }
}

@if (_detailFields is not null) {
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.35);">
        <div class="modal-dialog" style="max-width: 800px;">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">行詳細</h5>
                    <button type="button" class="btn-close" @onclick="CloseDetail"></button>
                </div>
                <div class="modal-body p-2">
                    <table class="table table-sm mb-0">
                        <tbody>
                            @foreach (var (label, value) in _detailFields) {
                                <tr><th class="text-muted fw-normal small" style="width: 20%">@label</th><td>@value</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseDetail">閉じる</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_usedSubProductId is not null) {
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.35);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">使用基板 (製品登録ID: @_usedSubProductId)</h5>
                    <button type="button" class="btn-close" @onclick="CloseUsedSubstrates"></button>
                </div>
                <div class="modal-body p-2">
                    <table class="table table-bordered table-sm mb-0">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>基板名</th>
                                <th>基板型式</th>
                                <th>基板製造番号</th>
                                <th>使用数</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_usedSubstratesError) {
                                <tr><td colspan="5" class="text-center text-danger">データの取得中にエラーが発生しました。</td></tr>
                            } else if (_usedSubstrates.Count == 0) {
                                <tr><td colspan="5" class="text-center text-muted">使用基板なし</td></tr>
                            } else {
                                @foreach (var s in _usedSubstrates) {
                                    <tr>
                                        <td>@s.Id</td>
                                        <td>@s.SubstrateName</td>
                                        <td>@s.SubstrateModel</td>
                                        <td>@s.SubstrateNumber</td>
                                        <td>@Math.Abs(s.Decrease ?? 0)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseUsedSubstrates">閉じる</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string _activeTab = "product";

    // ===== 製品タブ: 列定義（表示名, ソートキー） =====
    private static readonly (string Label, string SortKey)[] _productCols = [
        ("ID","ID"), ("カテゴリ","CategoryName"), ("製品名","ProductName"), ("種別","ProductType"),
        ("型式","ProductModel"), ("注文番号","OrderNumber"), ("製造番号","ProductNumber"), ("O-Les番号","OLesNumber"),
        ("数量","Quantity"), ("担当者","PersonInfo"), ("登録日","RegDate"), ("Revision","Revision"),
        ("シリアル開始","SerialFirst"), ("シリアル終了","SerialLast"), ("コメント","Comment"), ("登録日時","CreatedAt"),
    ];
    private static readonly (string Label, string SortKey)[] _serialCols = [
        ("No.","RowId"), ("シリアル番号","Serial"), ("O-Lesシリアル","OLesSerial"), ("注文番号","OrderNumber"),
