@page "/products/{Id:long}/edit"
@rendermode InteractiveServer
@attribute [Authorize]
@using ProductWebViewer.Blazor.Data
@using ProductWebViewer.Blazor.Models
@inject ProductWriteRepository WriteRepo
@inject AuditLogger AuditLogger
@inject ILogger<ProductEdit> Logger
@inject NavigationManager Navigation

<PageTitle>製品登録の編集</PageTitle>

@if (_notFound) {
    <div class="alert alert-warning">対象の製品登録が見つかりませんでした。</div>
} else if (_record is not null) {
    <h3 class="mb-3">製品登録の編集（ID: @_record.Id）</h3>

    @if (_errorMessage is not null) {
        <div class="alert alert-danger">@_errorMessage</div>
    }

    <dl class="row">
        <dt class="col-sm-2">製品名</dt><dd class="col-sm-10">@_record.ProductName</dd>
        <dt class="col-sm-2">型式</dt><dd class="col-sm-10">@_record.ProductModel</dd>
        <dt class="col-sm-2">登録日</dt><dd class="col-sm-10">@_record.RegDate</dd>
        <dt class="col-sm-2">Revision</dt><dd class="col-sm-10">@_record.Revision</dd>
    </dl>

    <div class="row mb-3">
        <div class="col-md-4">
            <label class="form-label">注文番号</label>
            <input class="form-control" @bind="_orderNumber" />
        </div>
        <div class="col-md-4">
            <label class="form-label">製造番号</label>
            <input class="form-control" @bind="_productNumber" />
        </div>
        <div class="col-md-4">
            <label class="form-label">O-Les番号</label>
            <input class="form-control" @bind="_oLesNumber" />
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">コメント</label>
        <textarea class="form-control" @bind="_comment"></textarea>
    </div>

    @if (_confirmingDelete) {
        <div class="alert alert-danger">
            この製品登録を削除します。関連するシリアル履歴・基板使用履歴も削除されます。よろしいですか？
            <div class="mt-2">
                <button type="button" class="btn btn-danger btn-sm" @onclick="DeleteAsync">削除する</button>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _confirmingDelete = false">キャンセル</button>
            </div>
        </div>
    } else {
        <button type="button" class="btn btn-primary" @onclick="SaveAsync">保存</button>
        <a href="/" class="btn btn-secondary">キャンセル</a>
        <button type="button" class="btn btn-outline-danger float-end" @onclick="() => _confirmingDelete = true">削除</button>
    }
}

@code {
    [Parameter] public long Id { get; set; }

    private ProductRecord? _record;
    private bool _notFound;
    private bool _confirmingDelete;
    private string? _errorMessage;

    private string? _orderNumber;
    private string? _productNumber;
    private string? _oLesNumber;
    private string? _comment;

    protected override void OnInitialized() {
        _record = WriteRepo.GetById(Id);
        if (_record is null) {
            _notFound = true;
            return;
        }
        _orderNumber = _record.OrderNumber;
        _productNumber = _record.ProductNumber;
        _oLesNumber = _record.OLesNumber;
        _comment = _record.Comment;
    }

    private void SaveAsync() {
        var before = _record!;
        try {
            if (!WriteRepo.UpdateProduct(Id, _orderNumber, _productNumber, _oLesNumber, _comment)) {
                _errorMessage = "この製品登録は他の操作で既に削除されているため、更新できませんでした。";
                return;
            }
        } catch (Exception ex) {
            _errorMessage = ex.Message;
            return;
        }

        AuditLogging.TryLog(Logger, () => AuditLogger.LogProductEdit(before, _orderNumber, _productNumber, _oLesNumber, _comment));

        Navigation.NavigateTo("/");
    }

    private void DeleteAsync() {
        var before = _record!;
        ProductDeleteResult result;
        try {
            result = WriteRepo.DeleteProduct(Id);
            if (!result.Success) {
                _errorMessage = "この製品登録は他の操作で既に削除されています。";
                _confirmingDelete = false;
                return;
            }
        } catch (Exception ex) {
            _errorMessage = ex.Message;
            _confirmingDelete = false;
            return;
        }

        AuditLogging.TryLog(Logger, () => {
            AuditLogger.LogProductDelete(before);
            AuditLogger.LogProductSubstrateDelete(result.DeletedSubstrates, before.CategoryName);
            AuditLogger.LogProductSerialDelete(result.DeletedSerials, before.CategoryName);
        });

        Navigation.NavigateTo("/");
    }
}
