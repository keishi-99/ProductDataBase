@page "{id:long}"
@model ProductEditModel
@{
    ViewData["Title"] = "製品登録の編集";
}

<h3 class="mb-3">製品登録の編集（ID: @Model.Record.Id）</h3>

@if (!string.IsNullOrEmpty(Model.ErrorMessage)) {
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<dl class="row">
    <dt class="col-sm-2">製品名</dt><dd class="col-sm-10">@Model.Record.ProductName</dd>
    <dt class="col-sm-2">型式</dt><dd class="col-sm-10">@Model.Record.ProductModel</dd>
    <dt class="col-sm-2">登録日</dt><dd class="col-sm-10">@Model.Record.RegDate</dd>
    <dt class="col-sm-2">Revision</dt><dd class="col-sm-10">@Model.Record.Revision</dd>
</dl>

<form method="post">
    <input type="hidden" asp-for="Record.Id" />
    <div class="row mb-3">
        <div class="col-md-4">
            <label asp-for="Record.OrderNumber" class="form-label">注文番号</label>
            <input asp-for="Record.OrderNumber" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="Record.ProductNumber" class="form-label">製造番号</label>
            <input asp-for="Record.ProductNumber" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="Record.OLesNumber" class="form-label">O-Les番号</label>
            <input asp-for="Record.OLesNumber" class="form-control" />
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Record.Comment" class="form-label">コメント</label>
        <textarea asp-for="Record.Comment" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">保存</button>
    <a href="/" class="btn btn-secondary">キャンセル</a>
    <button type="submit" asp-page-handler="Delete" class="btn btn-outline-danger float-end"
            onclick="return confirm('この製品登録を削除します。よろしいですか？（関連するシリアル履歴も削除されます）');">
        削除
    </button>
</form>
