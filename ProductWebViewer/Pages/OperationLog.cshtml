@page
@model OperationLogModel
@{
    ViewData["Title"] = "操作ログ";
}

@section Styles {
<style>
    .log-table td, .log-table th {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 300px;
    }
    .log-table {
        position: relative;
    }
    .log-table th {
        position: sticky;
        top: 0;
        z-index: 1;
        background-color: var(--bs-tertiary-bg);
        color: var(--bs-body-color);
    }
    .col-resizer {
        position: absolute;
        right: 0;
        top: 0;
        width: 5px;
        height: 100%;
        cursor: col-resize;
        user-select: none;
    }
    .col-resizer:hover,
    .col-resizer.resizing {
        background-color: #0d6efd;
        opacity: 0.5;
    }
    .table-responsive {
        overflow-x: auto;
        overflow-y: auto;
    }
    /* このBootstrapバージョンは .table-danger 等にダークテーマ用の色定義を持たないため、
       alert・list-group等で使われている公式のdarkテーマ変数(-subtle/-text-emphasis)で明示的に上書きする */
    [data-bs-theme="dark"] .log-table .table-danger {
        --bs-table-bg: var(--bs-danger-bg-subtle);
        --bs-table-color: var(--bs-danger-text-emphasis);
        --bs-table-border-color: var(--bs-danger-border-subtle);
    }
    [data-bs-theme="dark"] .log-table .table-warning {
        --bs-table-bg: var(--bs-warning-bg-subtle);
        --bs-table-color: var(--bs-warning-text-emphasis);
        --bs-table-border-color: var(--bs-warning-border-subtle);
    }
    [data-bs-theme="dark"] .log-table .table-info {
        --bs-table-bg: var(--bs-info-bg-subtle);
        --bs-table-color: var(--bs-info-text-emphasis);
        --bs-table-border-color: var(--bs-info-border-subtle);
    }
    [data-bs-theme="dark"] .log-table .table-success {
        --bs-table-bg: var(--bs-success-bg-subtle);
        --bs-table-color: var(--bs-success-text-emphasis);
        --bs-table-border-color: var(--bs-success-border-subtle);
    }
</style>
}

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function () {
    var table = document.querySelector('.log-table');
    if (!table) return;

    // 列幅の自動計算（内容に合わせた幅を一度計算してから固定レイアウトに切り替える）
    table.style.tableLayout = 'auto';
    var ths = Array.from(table.querySelectorAll('thead th'));
    var widths = ths.map(function (th) { return Math.ceil(th.getBoundingClientRect().width); });
    ths.forEach(function (th, i) { th.style.width = widths[i] + 'px'; });
    table.style.tableLayout = 'fixed';

    // 列幅ドラッグハンドル
    ths.forEach(function (th) {
        var handle = document.createElement('div');
        handle.className = 'col-resizer';
        th.appendChild(handle);
        var startX, startW;
        handle.addEventListener('mousedown', function (e) {
            startX = e.pageX;
            startW = th.offsetWidth;
            handle.classList.add('resizing');
            function onMouseMove(e) {
                th.style.width = Math.max(40, startW + (e.pageX - startX)) + 'px';
            }
            function onMouseUp() {
                handle.classList.remove('resizing');
                document.removeEventListener('mousemove', onMouseMove);
                document.removeEventListener('mouseup', onMouseUp);
            }
            document.addEventListener('mousemove', onMouseMove);
            document.addEventListener('mouseup', onMouseUp);
            e.stopPropagation();
            e.preventDefault();
        });
    });

    // テーブルの高さをウィンドウの下から一定間隔になるよう動的に設定する
    function syncTableHeight() {
        var container = document.querySelector('.table-responsive');
        if (!container) return;
        var rect = container.getBoundingClientRect();

        // 登録実績画面(Index.cshtml)の syncTableHeight と同じ計算式。
        // OperationLog にはページネーション(nav)がないため bottomPad は main の pb-3 (16px) のみになる。
        var nav = container.closest('form')?.querySelector('nav.d-flex');
        var bottomPad = (nav ? nav.offsetHeight + 8 : 0) + 16;

        container.style.maxHeight = Math.max(150, window.innerHeight - rect.top - bottomPad) + 'px';
    }
    syncTableHeight();

    var resizeTimer;
    window.addEventListener('resize', function () {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(syncTableHeight, 100);
    });
});
</script>
}

<h3 class="mb-3">操作ログ</h3>

<form method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-auto">
        <label class="form-label">対象月</label>
        <select name="YearMonth" class="form-select" onchange="this.form.submit()">
            @foreach (var ym in Model.AvailableMonths) {
                if (ym == Model.YearMonth) {
                    <option value="@ym" selected>@ym[..4]年@(ym[4..])月</option>
                } else {
                    <option value="@ym">@ym[..4]年@(ym[4..])月</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label">操作種別</label>
        <select name="OperationType" class="form-select" onchange="this.form.submit()">
            <option value="">（すべて）</option>
            @foreach (var t in Model.OperationTypes) {
                if (t == Model.OperationType) {
                    <option value="@t" selected>@t</option>
                } else {
                    <option value="@t">@t</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label">キーワード</label>
        <input type="text" name="Keyword" value="@Model.Keyword" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">検索</button>
    </div>
    <div class="col-auto ms-auto">
        <span class="text-body-secondary">@Model.Entries.Count 件表示中</span>
    </div>
</form>

@if (Model.AvailableMonths.Count == 0) {
    <div class="text-center text-muted py-5">ログファイルがありません</div>
} else {
    <div class="table-responsive">
        <table class="table table-bordered table-sm table-hover log-table">
            <thead>
                <tr>
                    <th>日時</th>
                    <th>操作種別</th>
                    <th>カテゴリ</th>
                    <th>ID</th>
                    <th>注文番号</th>
                    <th>製造番号</th>
                    <th>OLes番号</th>
                    <th>製品名</th>
                    <th>タイプ</th>
                    <th>型式</th>
                    <th>数量</th>
                    <th>シリアル先頭</th>
                    <th>シリアル末尾</th>
                    <th>Revision</th>
                    <th>登録日</th>
                    <th>担当者</th>
                    <th>コメント</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Entries) {
                    <tr class="@OperationLogModel.RowCssClass(e.OperationType)">
                        <td>@e.Timestamp</td>
                        <td>@e.OperationType</td>
                        <td>@e.Category</td>
                        <td>@e.Id</td>
                        <td>@e.OrderNumber</td>
                        <td>@e.ProductNumber</td>
                        <td>@e.OLesNumber</td>
                        <td>@e.ProductName</td>
                        <td>@e.ProductType</td>
                        <td>@e.ProductModel</td>
                        <td>@e.Quantity</td>
                        <td>@e.SerialFirst</td>
                        <td>@e.SerialLast</td>
                        <td>@e.Revision</td>
                        <td>@e.RegDate</td>
                        <td>@e.PersonInfo</td>
                        <td>@e.Comment</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
