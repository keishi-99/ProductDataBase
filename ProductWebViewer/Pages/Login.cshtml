@page
@model LoginModel
@{
    ViewData["Title"] = "ログイン";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <h3 class="mb-3">管理者ログイン</h3>
        <form method="post">
            <input type="hidden" name="returnUrl" value="@Request.Query["returnUrl"]" />
            @if (!string.IsNullOrEmpty(Model.ErrorMessage)) {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }
            <div class="mb-3">
                <label asp-for="Password" class="form-label">パスワード</label>
                <input asp-for="Password" type="password" class="form-control" autofocus />
            </div>
            <button type="submit" class="btn btn-primary">ログイン</button>
        </form>
    </div>
</div>
