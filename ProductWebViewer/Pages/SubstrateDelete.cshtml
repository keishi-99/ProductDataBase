@page "{id:long}"
@model SubstrateDeleteModel
@{
    ViewData["Title"] = "基板登録の削除";
}

<h3 class="mb-3">基板登録の削除（ID: @Model.Record.Id）</h3>

@if (!string.IsNullOrEmpty(Model.ErrorMessage)) {
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<dl class="row">
    <dt class="col-sm-2">製品名</dt><dd class="col-sm-10">@Model.Record.ProductName</dd>
    <dt class="col-sm-2">基板名</dt><dd class="col-sm-10">@Model.Record.SubstrateName</dd>
    <dt class="col-sm-2">基板型式</dt><dd class="col-sm-10">@Model.Record.SubstrateModel</dd>
    <dt class="col-sm-2">注文番号</dt><dd class="col-sm-10">@Model.Record.OrderNumber</dd>
    <dt class="col-sm-2">製造番号</dt><dd class="col-sm-10">@Model.Record.SubstrateNumber</dd>
    <dt class="col-sm-2">入庫/出庫/不良</dt><dd class="col-sm-10">@Model.Record.Increase / @Model.Record.Decrease / @Model.Record.Defect</dd>
    <dt class="col-sm-2">登録日</dt><dd class="col-sm-10">@Model.Record.RegDate</dd>
    <dt class="col-sm-2">コメント</dt><dd class="col-sm-10">@Model.Record.Comment</dd>
</dl>

<form method="post">
    <button type="submit" class="btn btn-outline-danger"
            onclick="return confirm('この基板登録を削除します。よろしいですか？');">
        削除する
    </button>
    <a href="/?tab=substrate" class="btn btn-secondary">キャンセル</a>
</form>
