{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5009",
  "DatabasePath": "db/ProductRegistry.db",
  "Auth": {
    // 実際に運用するPC上でこの値を直接書き換えてパスワードを設定する（社内利用者の誤操作防止が目的の簡易認証）。
    // 未設定の場合はログインが常に失敗する（フェイルクローズ）。
    "AdminPassword": ""
  }
}
